{
  "name": "t-red-world",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node server/dev.js",
    "build": "npm run skills:check && npm run assets:check && tsc && vite build",
    "test": "node --test tests/*.test.js",
    "start": "node server/index.js",
    "test:browser": "node tests/economy-browser.mjs",
    "test:assets": "node tests/appearance-browser.mjs",
    "test:art-source": "node scripts/check-art.mjs",
    "test:graphics": "node tests/graphics-browser.mjs",
    "assets:check": "npm run test:art-source && node scripts/check-asset-rigs.mjs && node scripts/check-world-contract.mjs",
    "assets:audit": "python scripts/sprite_pipeline.py audit",
    "assets:normalize": "python scripts/sprite_pipeline.py normalize",
    "test:pipeline": "python tests/sprite_pipeline_test.py",
    "report:graphics": "node scripts/graphics-report.mjs",
    "skills:route": "node scripts/skill-router.mjs",
    "skills:check": "node scripts/check-development-skills.mjs",
    "skills:verify": "node scripts/verify-development.mjs",
    "dev:checkpoint": "node scripts/dev-checkpoint.mjs",
    "visual:capture": "node tests/visual-capture.mjs",
    "visual:compare": "node scripts/visual-regression.mjs compare",
    "visual:review": "node scripts/visual-regression.mjs review",
    "visual:check": "node scripts/visual-regression.mjs check",
    "test:visual": "node scripts/visual-self-check.mjs",
    "test:office": "node tests/office-browser.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "24.19.2",
    "pngjs": "7.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
